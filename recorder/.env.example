# Copy to .env (ignored by Git) and fill in. Never commit the token.
RECORDER_DISCORD_TOKEN=
# Right-click > Copy ID, with Developer Mode on in Discord's Advanced settings.
RECORDER_GUILD_ID=
RECORDER_VOICE_CHANNEL_ID=
RECORDER_TEXT_CHANNEL_ID=
RECORDER_GM_USER_ID=
# Where sessions land (compose.yaml sets /recordings). Default: recorder/recordings
RECORDER_OUTPUT_DIR=
# Seconds the voice channel must stay empty before the recording stops. Default: 60
RECORDER_GRACE_SECONDS=
# Optional shell command run after decoding; the session directory is $1. Example, bot run on the host:
# RECORDER_POST_COMMAND='cd ~/dev/personal/Campaign/campaign-kingmaker && tools/bin/ttrpg transcribe "$1" --day "$(basename "$1" | cut -c1-10)"'
RECORDER_POST_COMMAND=
# Optional replacement for the consent notice posted when recording starts.
RECORDER_NOTICE=
